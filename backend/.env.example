PORT=5000
NODE_ENV=development

# Supabase (get from app.supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# JWT secrets (use long random strings in production)
JWT_SECRET=change_this_to_a_long_random_secret_key_32chars
ADMIN_JWT_SECRET=change_this_to_another_long_random_secret

# Admin credentials — use a long random password, NEVER a weak/default value
ADMIN_PASSWORD=

# OTP test bypass: leave both UNSET in production. Only for local testing,
# set ALLOW_TEST_OTP=true and TEST_OTP=<code>. If unset, real OTP is required.
ALLOW_TEST_OTP=
TEST_OTP=

# Razorpay (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Fast2SMS (get from fast2sms.com) — leave blank to log OTPs to console instead
FAST2SMS_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=https://contact-drivedilse.github.io
